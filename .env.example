# Copy to .env (gitignored) for `vercel dev`, which reads .env instead of the
# Development values on Vercel and ignores .env.local. Never commit real values.

# Browser (bundled into the SPA; must be public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only (api/ functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna
OPENAI_MODEL=
